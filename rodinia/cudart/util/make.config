# CUDA toolkit installation path
CUDA_DIR = /usr/local/cuda-10.1

# CUDA toolkit libraries
CUDA_LIB_DIR := $(CUDA_DIR)/lib
ifeq ($(shell uname -m), x86_64)
     ifeq ($(shell if test -d $(CUDA_DIR)/lib64; then echo T; else echo F; fi), T)
     	CUDA_LIB_DIR := $(CUDA_DIR)/lib64
     endif
endif

# NVIDIA
NV_CUDA_DIR = $(CUDA_DIR)
NV_CUDA_INC = $(NV_CUDA_DIR)/include
NV_CUDA_LIB_DIR = $(NV_CUDA_DIR)/lib64
NV_CUDA_LIB = -lcuda -lcudart

# AvA
AVA_ROOT = /home/ymx/ava/build
AVA_LIB_DIR = $(AVA_ROOT)/install/cudart/lib   #/cava/cudart_nw
AVA_LIB = -lcudart -lcuda -lguestlib #-Wl,-rpath,$(AVA_LIB_DIR)

CUDA_INC = $(NV_CUDA_INC)

# SWITCH
#CUDA_LIB_DIR = $(NV_CUDA_LIB_DIR)
#CUDA_LIB = $(NV_CUDA_LIB)
CUDA_LIB_DIR = $(AVA_LIB_DIR)
CUDA_LIB  = $(AVA_LIB)
