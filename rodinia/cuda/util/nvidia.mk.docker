AVA_ROOT=/home/ymx/ava
CUDA_HOME=/usr/local/cuda-10.1

AVA_LIB = $(AVA_ROOT)/build/cava/cudadrv_nw
CUDA_LIB = $(CUDA_HOME)/lib64
CUDA_INC = /usr/local/cuda-10.1/include

LIB_NAME = cuda
# comment out to run with native library on the host
#LIB_NAME = guestlib

CC = gcc
ifeq ($(CC),)
	CC = gcc
endif
NVCC = /usr/local/cuda-10.1/bin/nvcc

# use sm_30 on listug for GTX 680
NVCCFLAGS += -ptx

#CFLAGS += -O3 -I$(CUDA_TOP_DIR)/util \
#	-I$(CUDA_INC) \
#	-L$(CUDA_LIB) -lcudart -lcuda \
#	-Wall -Wno-unused-result -g

CFLAGS += -O3 -I$(CUDA_TOP_DIR)/util \
        -I$(CUDA_INC) \
        -L$(CUDA_LIB) -lcudart  -L$(AVA_LIB) \
        -l$(LIB_NAME) -lguestlib \
        -Wall -Wno-unused-result

CCFILES += $(CUDA_TOP_DIR)/util/util.c

.PHONY: all clean
all:
	$(NVCC) -ptx -o $(EXECUTABLE).ptx $(CUFILES) 
	$(CC) -o $(EXECUTABLE) $(CCFILES) $(CFLAGS)

clean:
	rm -f $(EXECUTABLE) $(EXECUTABLE).ptx *~
